# Copy this file to .env.local (gitignored) and fill in your real key —
# or add RESEND_API_KEY as an environment variable in your Vercel project
# settings for production.
#
# Get a free key at https://resend.com — no domain verification needed to
# start, but without one you can only send to the email address your
# Resend account was signed up with. Once a domain is verified, update
# ENQUIRY_RECIPIENT_EMAIL in src/lib/data.ts to any address on it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The deployed production URL. Used for Open Graph/Twitter image URLs, the
# canonical tag, and sitemap.xml/robots.txt. Optional locally — falls back
# to a placeholder — but should be set in Vercel's project env vars once
# the real domain is known.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
